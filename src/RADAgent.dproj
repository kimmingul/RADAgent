    <VerInfo_MajorVer>1</VerInfo_MajorVer>
    <VerInfo_MinorVer>2</VerInfo_MinorVer>
    <VerInfo_Release>4</VerInfo_Release>
    <VerInfo_Keys>CompanyName=Nanum Space Co., Ltd.;FileDescription=RAD Agent — an agentic coding assistant for Delphi, powered by oh-my-pi;FileVersion=1.2.4.0;InternalName=RADAgent;LegalCopyright=Copyright (C) 2026 Nanum Space Co., Ltd.;LegalTrademarks=;OriginalFilename=RADAgent.bpl;ProductName=RAD Agent;ProductVersion=1.2.4.0;Comments=</VerInfo_Keys>
